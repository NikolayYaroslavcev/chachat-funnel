generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String
  createdAt DateTime @default(now()) @map("created_at")

  visitors        Visitor[]
  paymentAttempts PaymentAttempt[]
  purchases       Purchase[]
  funnelEvents    FunnelEvent[]

  @@map("users")
}

model Visitor {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id])

  sessions Session[]

  @@index([userId])
  @@map("visitors")
}

model Session {
  id             String   @id @default(cuid())
  visitorId      String   @map("visitor_id")
  visitor        Visitor  @relation(fields: [visitorId], references: [id])
  startedAt      DateTime @default(now()) @map("started_at")
  lastActivityAt DateTime @default(now()) @map("last_activity_at")

  utmSource   String? @map("utm_source")
  utmMedium   String? @map("utm_medium")
  utmCampaign String? @map("utm_campaign")
  utmTerm     String? @map("utm_term")
  utmContent  String? @map("utm_content")
  referrer    String?
  landingUrl  String? @map("landing_url")
  userAgent   String? @map("user_agent")

  quizAnswers  QuizAnswer[]
  funnelEvents FunnelEvent[]

  @@index([visitorId])
  @@index([startedAt])
  @@map("sessions")
}

model QuizAnswer {
  id          String   @id @default(cuid())
  sessionId   String   @map("session_id")
  session     Session  @relation(fields: [sessionId], references: [id])
  questionKey String   @map("question_key")
  answerValue String   @map("answer_value")
  answeredAt  DateTime @updatedAt @map("answered_at")

  @@unique([sessionId, questionKey])
  @@map("quiz_answers")
}

enum FunnelEventName {
  screen_view
  quiz_answer_submitted
  quiz_completed
  email_submitted
  plan_selected
  purchase_attempted
  purchase_succeeded
  purchase_failed
  install_viewed

  @@map("funnel_event_name")
}

model FunnelEvent {
  id        String  @id @default(cuid())
  sessionId String  @map("session_id")
  session   Session @relation(fields: [sessionId], references: [id])
  userId    String? @map("user_id")
  user      User?   @relation(fields: [userId], references: [id])

  eventName  FunnelEventName @map("event_name")
  occurredAt DateTime        @default(now()) @map("occurred_at")
  properties Json?

  paymentAttemptId String?         @map("payment_attempt_id")
  paymentAttempt   PaymentAttempt? @relation(fields: [paymentAttemptId], references: [id])
  purchaseId       String?         @map("purchase_id")
  purchase         Purchase?       @relation(fields: [purchaseId], references: [id])
  planId           String?         @map("plan_id")
  plan             Plan?           @relation(fields: [planId], references: [id])

  @@index([sessionId])
  @@index([userId])
  @@index([eventName])
  @@index([occurredAt])
  @@map("funnel_events")
}

model Plan {
  id                String   @id @default(cuid())
  slug              String   @unique
  name              String
  priceAmount       Decimal  @db.Decimal(10, 2) @map("price_amount")
  currency          String   @db.Char(3)
  billingPeriodDays Int      @map("billing_period_days")
  displayOrder      Int      @map("display_order")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")

  paymentAttempts PaymentAttempt[]
  purchases       Purchase[]
  funnelEvents    FunnelEvent[]

  @@map("plans")
}

enum PaymentAttemptStatus {
  initiated
  processing
  succeeded
  declined
  timed_out
  errored

  @@map("payment_attempt_status")
}

model PaymentAttempt {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])
  planId String @map("plan_id")
  plan   Plan   @relation(fields: [planId], references: [id])

  status PaymentAttemptStatus @default(initiated)

  maskedCardNumber String? @map("masked_card_number")
  resultMessage    String? @map("result_message")

  idempotencyKey String? @map("idempotency_key")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  completedAt DateTime? @map("completed_at")

  purchase     Purchase?
  funnelEvents FunnelEvent[]

  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@index([planId])
  @@index([status])
  @@map("payment_attempts")
}

model Purchase {
  id               String         @id @default(cuid())
  paymentAttemptId String         @unique @map("payment_attempt_id")
  paymentAttempt   PaymentAttempt @relation(fields: [paymentAttemptId], references: [id])
  userId           String         @map("user_id")
  user             User           @relation(fields: [userId], references: [id])
  planId           String         @map("plan_id")
  plan             Plan           @relation(fields: [planId], references: [id])

  amount      Decimal  @db.Decimal(10, 2)
  currency    String   @db.Char(3)
  purchasedAt DateTime @default(now()) @map("purchased_at")

  funnelEvents FunnelEvent[]

  @@index([userId])
  @@index([planId])
  @@index([purchasedAt])
  @@map("purchases")
}
