// Application data model for the ChaChat funnel.
//
// Source of truth: docs/spec.md, section 9 ("Data model") plus the
// identity/payment invariants in sections 5-13. Table/column names use
// snake_case (via @@map/@map) to match the entity names spec.md uses.
//
// Invariants that cannot be expressed with plain Prisma schema constructs
// (case-insensitive email uniqueness, visitor.user_id immutability, payment
// state transitions, purchase requiring a succeeded attempt, append-only
// funnel_events, at-most-one-active-attempt-per-user) are implemented as
// raw SQL in the migration (functional unique index / partial unique index /
// triggers) and are called out with a comment next to the relevant model.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

/// Identified user of the funnel. Exactly one row per real-world email.
///
/// Email uniqueness is case-insensitive (spec 5-6), which Prisma's `@unique`
/// cannot express directly (it produces a case-sensitive btree unique
/// constraint). Enforced instead by a functional unique index on
/// `lower(email)`, added via raw SQL in the migration.
model User {
  id        String   @id @default(cuid())
  email     String
  createdAt DateTime @default(now()) @map("created_at")

  visitors        Visitor[]
  paymentAttempts PaymentAttempt[]
  purchases       Purchase[]
  funnelEvents    FunnelEvent[]

  @@map("users")
}

/// Anonymous, cross-session identity holding all pre-email history. The row
/// id doubles as the opaque client-facing token (no separate token column
/// needed — a cuid is already unguessable).
///
/// `user_id` is set once at email-submit time and, per spec 5, must never
/// switch to a different user afterwards (only a repeat write of the same
/// value is allowed). That is an update-time invariant a static schema
/// constraint can't express, so it's enforced by a BEFORE UPDATE trigger
/// added via raw SQL in the migration.
///
/// Intentionally N:1 towards User (not unique) — the spec allows multiple
/// visitors to independently link to the same existing user.
model Visitor {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id])

  sessions Session[]

  @@index([userId])
  @@map("visitors")
}

/// A single visit, scoped to one visitor. Holds attribution (fixed once at
/// creation from the first request of the session — spec 8) and is the
/// parent of quiz answers and funnel events for that visit.
model Session {
  id             String   @id @default(cuid())
  visitorId      String   @map("visitor_id")
  visitor        Visitor  @relation(fields: [visitorId], references: [id])
  startedAt      DateTime @default(now()) @map("started_at")
  lastActivityAt DateTime @default(now()) @map("last_activity_at")

  // Attribution (spec 8) — captured once from the first request of the
  // session. Nothing below is DB-enforced as immutable: that's a "the app
  // simply never issues an UPDATE on these columns" discipline rather than a
  // structural integrity threat on par with the ones that got triggers, so
  // it's left for the business-logic stage (see report).
  utmSource   String? @map("utm_source")
  utmMedium   String? @map("utm_medium")
  utmCampaign String? @map("utm_campaign")
  utmTerm     String? @map("utm_term")
  utmContent  String? @map("utm_content")
  referrer    String?
  landingUrl  String? @map("landing_url")
  userAgent   String? @map("user_agent")

  quizAnswers  QuizAnswer[]
  funnelEvents FunnelEvent[]

  @@index([visitorId])
  @@index([startedAt])
  @@map("sessions")
}

/// One answer per (session, question). Re-answering the same question in the
/// same session updates the existing row rather than creating a new one
/// (spec 4.2, 9) — the unique constraint below is what a later upsert
/// (`ON CONFLICT (session_id, question_key) DO UPDATE`) relies on.
model QuizAnswer {
  id          String   @id @default(cuid())
  sessionId   String   @map("session_id")
  session     Session  @relation(fields: [sessionId], references: [id])
  questionKey String   @map("question_key")
  answerValue String   @map("answer_value")
  answeredAt  DateTime @updatedAt @map("answered_at")

  @@unique([sessionId, questionKey])
  @@map("quiz_answers")
}

// ---------------------------------------------------------------------------
// Analytics
// ---------------------------------------------------------------------------

/// Closed set of event names from spec 10. Modeled as an enum (not a free
/// string) so the DB itself rejects an unrecognized event name.
enum FunnelEventName {
  screen_view
  quiz_answer_submitted
  quiz_completed
  email_submitted
  plan_selected
  purchase_attempted
  purchase_succeeded
  purchase_failed
  install_viewed

  @@map("funnel_event_name")
}

/// Append-only log of every meaningful funnel action (spec 10). `userId` is
/// a point-in-time snapshot of the identity known when the event fired (a
/// pre-identification screen_view legitimately has user_id = null even
/// though the owning session's visitor later links to a user) — it is not
/// redundant with a session -> visitor -> user join, which would report the
/// user's *current* link, not the one at event time. `visitor_id` is not
/// duplicated here since a session's visitor never changes, so
/// session -> visitor is a lossless, always-consistent join (spec 10
/// explicitly allows deriving it this way).
///
/// Immutability ("events are append-only", spec 9) is enforced by a trigger
/// blocking UPDATE/DELETE, added via raw SQL in the migration.
model FunnelEvent {
  id        String  @id @default(cuid())
  sessionId String  @map("session_id")
  session   Session @relation(fields: [sessionId], references: [id])
  userId    String? @map("user_id")
  user      User?   @relation(fields: [userId], references: [id])

  eventName  FunnelEventName @map("event_name")
  occurredAt DateTime        @default(now()) @map("occurred_at")
  properties Json?

  paymentAttemptId String?         @map("payment_attempt_id")
  paymentAttempt   PaymentAttempt? @relation(fields: [paymentAttemptId], references: [id])
  purchaseId       String?         @map("purchase_id")
  purchase         Purchase?       @relation(fields: [purchaseId], references: [id])
  planId           String?         @map("plan_id")
  plan             Plan?           @relation(fields: [planId], references: [id])

  @@index([sessionId])
  @@index([userId])
  @@index([eventName])
  @@index([occurredAt])
  @@map("funnel_events")
}

// ---------------------------------------------------------------------------
// Plans / payments
// ---------------------------------------------------------------------------

/// Immutable reference catalog of the three subscription plans (spec 14).
/// Rows are seed data, not created by the application — see prisma/seed.mjs.
model Plan {
  id                String   @id @default(cuid())
  slug              String   @unique
  name              String
  priceAmount       Decimal  @db.Decimal(10, 2) @map("price_amount")
  currency          String   @db.Char(3)
  billingPeriodDays Int      @map("billing_period_days")
  displayOrder      Int      @map("display_order")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")

  paymentAttempts PaymentAttempt[]
  purchases       Purchase[]
  funnelEvents    FunnelEvent[]

  @@map("plans")
}

/// Payment state machine states (spec 11). Terminal: succeeded, declined,
/// timed_out, errored — no transition out of a terminal state. `initiated`
/// may also move directly to `errored` (stage 12) — this is not a PSP
/// outcome, it is how an abandoned attempt that never reached `processing`
/// (e.g. the server crashed between creating it and the next step) gets
/// reaped so it stops permanently blocking the one-active-attempt-per-user
/// invariant for that user; see STALE_ACTIVE_ATTEMPT_MS in lib/payment.ts.
enum PaymentAttemptStatus {
  initiated
  processing
  succeeded
  declined
  timed_out
  errored

  @@map("payment_attempt_status")
}

/// One attempt at paying for a plan. Every attempt, successful or not, gets
/// a row here — it is the single source of truth for what happened during a
/// specific attempt (spec 9, 11).
///
/// Two invariants that need to see more than a single row/column are
/// enforced via raw SQL in the migration rather than plain Prisma
/// constructs:
/// - at most one non-terminal (initiated/processing) attempt per user at a
///   time (spec 13) — a partial unique index on (user_id) WHERE status IN
///   ('initiated','processing'). This is also what makes the guarantee hold
///   under real concurrency: a second concurrent INSERT simply fails the
///   unique index at commit time.
/// - status only moves forward along the allowed edges, never out of a
///   terminal state (spec 11), including the stage-12 `initiated -> errored`
///   reap edge — a BEFORE UPDATE trigger.
/// - (stage 12) at most one attempt per (user, idempotency_key) — a plain
///   unique index, since NULL idempotency_key values are never considered
///   equal to each other by Postgres, so callers that don't send a key are
///   unaffected. This is what lets a request that repeats an
///   already-*terminal* operation (e.g. a client retry after a network
///   failure that actually reached the server, spec 13's "Network failure"
///   scenario) be recognized as the same logical operation instead of a new
///   one — the one-active-attempt-per-user index above only covers
///   concurrent/duplicate requests while an attempt is still non-terminal.
model PaymentAttempt {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])
  planId String @map("plan_id")
  plan   Plan   @relation(fields: [planId], references: [id])

  status PaymentAttemptStatus @default(initiated)

  // Fake-PSP-specific result data (spec 9): e.g. a masked card number, and
  // whatever detail the fake PSP returns for a decline/error.
  maskedCardNumber String? @map("masked_card_number")
  resultMessage    String? @map("result_message")

  // (stage 12) Optional client-supplied correlation id for one logical
  // purchase-button action, used to recognize a repeated/retried request as
  // the same operation even after it has gone terminal. Never used as the
  // sole concurrency guarantee (spec 13 explicitly rejects that — two tabs
  // can't share a client-generated value) — only as an additional signal on
  // top of the per-user active-attempt constraint above.
  idempotencyKey String? @map("idempotency_key")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  completedAt DateTime? @map("completed_at")

  purchase     Purchase?
  funnelEvents FunnelEvent[]

  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@index([planId])
  @@index([status])
  @@map("payment_attempts")
}

/// A successful purchase. Exists only for a `succeeded` payment_attempt,
/// created atomically with that transition (spec 11) — enforced by a
/// BEFORE INSERT trigger checking the referenced attempt's status, added via
/// raw SQL in the migration. `payment_attempt_id` is unique, giving the
/// required 1:1 (at most one purchase per attempt) for free.
///
/// `amount`/`currency` are captured at purchase time rather than read
/// live from `plan` — a standard snapshot so historical revenue stays
/// correct even if a plan's price is edited later.
model Purchase {
  id               String         @id @default(cuid())
  paymentAttemptId String         @unique @map("payment_attempt_id")
  paymentAttempt   PaymentAttempt @relation(fields: [paymentAttemptId], references: [id])
  userId           String         @map("user_id")
  user             User           @relation(fields: [userId], references: [id])
  planId           String         @map("plan_id")
  plan             Plan           @relation(fields: [planId], references: [id])

  amount      Decimal  @db.Decimal(10, 2)
  currency    String   @db.Char(3)
  purchasedAt DateTime @default(now()) @map("purchased_at")

  funnelEvents FunnelEvent[]

  @@index([userId])
  @@index([planId])
  @@index([purchasedAt])
  @@map("purchases")
}
