# Copy this file to .env before running `docker compose up`.
# These are local/dev-only defaults — not used for anything real.

POSTGRES_USER=chachat
POSTGRES_PASSWORD=chachat
POSTGRES_DB=chachat_funnel
POSTGRES_PORT=5432

# Used by the app container (and by Prisma locally). Host name must match
# the postgres service name in docker-compose.yml.
DATABASE_URL=postgresql://chachat:chachat@db:5432/chachat_funnel

APP_PORT=3000
